{
  "name": "solo-trainer",
  "private": true,
  "version": "1.0.0",
  "description": "A Solo Leveling themed fitness quest system: daily quests, AI rep detection, gates, shadows and level-ups.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-mediapipe.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "art": "node scripts/generate-art.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.5",
    "framer-motion": "11.18.2",
    "@mediapipe/tasks-vision": "0.10.21"
  },
  "devDependencies": {
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  }
}
